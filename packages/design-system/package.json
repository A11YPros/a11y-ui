{
  "name": "@a11ypros/a11y-ui-components",
  "version": "2.2.0",
  "description": "Accessibility-first React component library built for WCAG 2.1/2.2 AA & AAA compliance, screen reader support, keyboard navigation, and production design systems.",
  "keywords": [
    "react",
    "accessibility",
    "a11y",
    "wcag",
    "wcag21",
    "wcag22",
    "screen-reader",
    "aria",
    "wai-aria",
    "design-system",
    "components",
    "typescript",
    "headless-ui",
    "radix-ui",
    "ui-library",
    "accessible-components",
    "keyboard-navigation",
    "focus-trap",
    "react-components"
  ],
  "author": "Ryan Mack <ryan@a11ypros.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/styles/global.css"
    },
    "./styles/components": {
      "import": "./dist/styles/components.css"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/A11YPros/a11y-ui.git",
    "directory": "packages/design-system"
  },
  "bugs": {
    "url": "https://github.com/A11YPros/a11y-ui/issues"
  },
  "homepage": "https://ui.a11ypros.com",
  "scripts": {
    "build": "tsc && node scripts/copy-css.js",
    "prepublishOnly": "npm run build",
    "storybook": "cd ../.. && npm run storybook",
    "build-storybook": "cd ../.. && npm run build-storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^23.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
